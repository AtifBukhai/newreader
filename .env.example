# ============================================
# Kitabo — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ============================================
# SUPABASE (Required for production)
# ============================================
# Get these from your Supabase project settings:
# https://app.supabase.com → Project Settings → API

# Public URL of your Supabase project
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Public anonymous key (safe to expose in client)
# Found in Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=

# ============================================
# IMPORTANT SECURITY NOTES
# ============================================
# 
# NEVER put these in VITE_ prefixed variables (they'd be exposed to the browser):
# - SUPABASE_SERVICE_ROLE_KEY (has full database access)
# - Database connection strings with credentials
# - Storage bucket secrets
# - Email provider API keys
#
# Service-role operations must run in Supabase Edge Functions
# or another trusted server-side environment.
#
# ============================================
# OPTIONAL: Email Provider (for password resets)
# ============================================
# Configure in Supabase Dashboard → Authentication → Email Templates
# Or use a custom SMTP provider via Edge Functions.
# No client-side env vars needed for this.

# ============================================
# OPTIONAL: Storage (for book files)
# ============================================
# Configure a Supabase Storage bucket named "books" with:
# - Public access: DISABLED
# - File size limit: 100MB
# - Allowed MIME types: application/pdf, application/epub+zip
# Access is controlled via RLS policies and signed URLs.

# ============================================
# DEMO MODE
# ============================================
# If VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are NOT set,
# the application runs in DEMO MODE with in-memory storage.
# Demo mode:
# - Does NOT persist data across page refreshes
# - Uses simulated authentication (any demo email works)
# - Enforces all business rules (validation, authorization)
# - Is clearly labeled in the UI
# - Is NOT suitable for production use
